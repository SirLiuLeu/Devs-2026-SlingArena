{
  "name": "roj3",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/ReplicatedStorage/Shared"
      },
      "SlingArenaRemotes": {
        "$path": "src/ReplicatedStorage/SlingArenaRemotes"
      },
      "Client": {
        "$path": "src/ReplicatedStorage/Client"
      }
    },
    "ServerScriptService": {
      "$path": "src/ServerScriptService"
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "$path": "src/StarterPlayer"
      }
    }
  },
  "StarterGui": {
    "$path": "src/StarterGui"
  },
  "Workspace": {
    "$properties": {
      "FilteringEnabled": true
    },
    "$path": "src/Workspace"
  },
  "Lighting": {
    "$properties": {
      "Ambient": [
        0,
        0,
        0
      ],
      "Brightness": 2,
      "GlobalShadows": true,
      "Outlines": false,
      "Technology": "Voxel"
    }
  },
  "SoundService": {
    "$properties": {
      "RespectFilteringEnabled": true
    }
  }
}